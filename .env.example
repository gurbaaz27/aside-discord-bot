# Discord application credentials
DISCORD_TOKEN=your-bot-token
DISCORD_CLIENT_ID=your-application-id
DISCORD_GUILD_ID=your-server-id
# Your Discord user ID. The bot ignores everyone else.
DISCORD_USER_ID=your-user-id

# Optional: defaults are detected from the signed-in Aside account.
# ASIDE_CLI=/Users/you/.aside/cli/Aside CLI.app/Contents/MacOS/aside
# ASIDE_SESSIONS_DIR=/Users/you/.aside/u/0/sessions
# ASIDE_MODEL=
ASIDE_EFFORT=medium
ASIDE_EXEC_TIMEOUT_SECONDS=1200

# Runtime files (state, logs, downloaded attachments)
DATA_DIR=.data
